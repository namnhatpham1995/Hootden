PORT=8080
DATABASE_URL=postgres://postgres:postgres@localhost:5432/hootden?sslmode=disable
APP_ORIGIN=http://localhost:3000
# Optional -- leave these three unset and email/password is the only
# sign-in method; the frontend hides the Google button on its own. Set all
# three to also offer Google sign-in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:8080/auth/google/callback
# Domain attribute for the session cookie, e.g. ".hootden.example" so it's
# shared by the apex and an api. subdomain. Leave empty for a host-only
# cookie, which is what localhost needs.
COOKIE_DOMAIN=
